{
  "realm": "esep",
  "enabled": true,
  "displayName": "ESEP Local Identity",
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "rememberMe": false,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "waitIncrementSeconds": 30,
  "maxFailureWaitSeconds": 900,
  "accessTokenLifespan": 300,
  "accessTokenLifespanForImplicitFlow": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 28800,
  "accessCodeLifespan": 60,
  "accessCodeLifespanLogin": 300,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "defaultSignatureAlgorithm": "RS256",
  "roles": {
    "client": {
      "esep-api": [
        {
          "name": "USER",
          "description": "ESEP standard user"
        },
        {
          "name": "ADMIN",
          "description": "ESEP business administrator; explicit assignment only"
        }
      ]
    }
  },
  "clients": [
    {
      "clientId": "esep-api",
      "name": "ESEP API resource",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "redirectUris": [],
      "webOrigins": []
    },
    {
      "clientId": "esep-web",
      "name": "ESEP local web client",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "redirectUris": [
        "http://localhost:5173/oidc/callback"
      ],
      "webOrigins": [
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/"
      },
      "defaultClientScopes": [
        "web-origins",
        "profile",
        "email"
      ],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "esep-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "esep-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "esep-api-client-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "config": {
            "usermodel.clientRoleMapping.clientId": "esep-api",
            "claim.name": "resource_access.esep-api.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clientScopeMappings": {
    "esep-api": [
      {
        "client": "esep-web",
        "roles": [
          "USER",
          "ADMIN"
        ]
      }
    ]
  }
}
