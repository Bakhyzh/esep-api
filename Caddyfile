# Caddy gets and renews a Let's Encrypt certificate for {$DOMAIN} automatically
# (the DNS A record must point to this server and ports 80/443 must be open).
# HTTP is redirected to HTTPS automatically. Certificates are stored in the caddy_data volume.

{$DOMAIN} {
	encode zstd gzip

	# only the API and the health check are public; actuator has nothing else exposed anyway
	@blocked path /actuator /actuator/*
	@health path /actuator/health
	handle @health {
		reverse_proxy app:8081
	}
	handle @blocked {
		respond 404
	}

	handle {
		# X-Forwarded-For / -Proto are set by Caddy; the app trusts them only from the internal network
		reverse_proxy app:8081
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	log {
		output stdout
		format console
	}
}
