# Production environment for docker-compose.prod.yml.
# On the server: cp .env.example .env && chmod 600 .env, then fill in the values.
# NEVER commit .env (it is in .gitignore). Only this template with empty values belongs in git.

# --- public address ---
# API domain or subdomain; its DNS A record must point to the server (Caddy issues the HTTPS certificate for it)
DOMAIN=api.example.com
# browser origins allowed to call the API, comma-separated, no path and no trailing slash
# GitHub Pages: https://<github-user>.github.io  (lowercase, without /esep-web)
CORS_ALLOWED_ORIGINS=https://example.github.io

# --- PostgreSQL ---
# "postgres" is the service name inside the compose network
DB_URL=jdbc:postgresql://postgres:5432/esep
DB_USER=esep
# generate: openssl rand -base64 24
DB_PASSWORD=

# --- JWT ---
# HMAC-SHA256 key, at least 32 bytes (the app refuses to start with a shorter one)
# generate: openssl rand -base64 48
# changing it logs out every user (all issued tokens become invalid)
JWT_SECRET=

# --- Redis and Kafka (service names inside the compose network; usually no need to change) ---
REDIS_HOST=redis
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# --- optional demo user (created/updated on startup only when enabled) ---
DEMO_USER_ENABLED=false
DEMO_USER_EMAIL=demo@example.com
# generate: openssl rand -base64 12   (at least 8 characters)
DEMO_USER_PASSWORD=

# --- image version, set by the deploy workflow; "latest" or a short commit sha for a rollback ---
IMAGE_TAG=latest
