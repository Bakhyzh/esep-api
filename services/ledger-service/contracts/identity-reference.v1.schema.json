{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ApprovedLedgerIdentityReferenceV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "userId",
    "issuer",
    "subject",
    "approvedOperator"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "userId": {
      "type": "integer",
      "minimum": 1
    },
    "issuer": {
      "type": "string",
      "format": "uri",
      "maxLength": 512
    },
    "subject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "approvedOperator": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    }
  }
}
