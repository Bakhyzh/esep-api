    "/api/transactions/{id}": {
      "get": {
        "operationId": "getById",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionResponse"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Validation failed or invalid parameters (VALIDATION_FAILED, INVALID_REQUEST, ...)"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Missing, invalid or expired token (UNAUTHORIZED)"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Authenticated, but not allowed (FORBIDDEN)"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Resource not found or belongs to another user (RESOURCE_NOT_FOUND)"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Conflict or concurrent modification, retry (CONFLICT, CONCURRENT_MODIFICATION, ...)"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Business rule violated (INSUFFICIENT_FUNDS, CURRENCY_MISMATCH, ...)"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Unexpected error (INTERNAL_ERROR)"
          }
        },
        "summary": "Get a transaction with its ledger entries (participants and ADMIN)",
        "tags": [
          "Transactions"
        ]
      }
    },
    "/api/transfers": {
      "post": {
        "operationId": "transfer",
        "parameters": [
          {
            "description": "Unique per logical operation (e.g. a UUID generated by the client). Repeat it when retrying the same operation: the original result is returned and money moves once.",
            "example": "3f1c2b8e-6c1d-4c7a-9a55-0b6f3e2d9a10",
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "maxLength": 64,
              "minLength": 0,
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TransferRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionResponse"
                }
              }
            },
            "description": "Replay of an earlier request with the same Idempotency-Key",
            "headers": {
              "Idempotent-Replayed": {
                "description": "Always \"true\" on a replay",
                "style": "simple"
              }
            }
          },
          "201": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionResponse"
                }
              }
            },
            "description": "Transfer completed",
            "headers": {
              "Location": {
                "description": "URL of the created transaction",
                "style": "simple"
              }
            }
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Validation failed or invalid parameters (VALIDATION_FAILED, INVALID_REQUEST, ...)"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Missing, invalid or expired token (UNAUTHORIZED)"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Authenticated, but not allowed (FORBIDDEN)"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Resource not found or belongs to another user (RESOURCE_NOT_FOUND)"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Conflict or concurrent modification, retry (CONFLICT, CONCURRENT_MODIFICATION, ...)"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Business rule violated (INSUFFICIENT_FUNDS, CURRENCY_MISMATCH, ...)"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Unexpected error (INTERNAL_ERROR)"
          }
        },
        "summary": "Transfer money from an own account (201; retry with the same key: 200 + Idempotent-Replayed)",
        "tags": [
          "Transactions"
        ]
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
