{
  "components": {
    "schemas": {
      "AccountResponse": {
        "properties": {
          "balance": {
            "type": "number"
          },
          "closedAt": {
            "format": "date-time",
            "type": "string"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "status": {
            "enum": [
              "ACTIVE",
              "CLOSED"
            ],
            "type": "string"
          },
          "type": {
            "enum": [
              "USER",
              "SYSTEM"
            ],
            "type": "string"
          },
          "userId": {
            "format": "int64",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "ApiError": {
        "description": "Every error response (RFC 9457 problem+json with a stable code)",
        "properties": {
          "code": {
            "description": "Stable machine-readable code",
            "enum": [
              "VALIDATION_FAILED",
              "INVALID_REQUEST",
              "MALFORMED_REQUEST",
              "MISSING_PARAMETER",
              "UNAUTHORIZED",
              "INVALID_CREDENTIALS",
              "FORBIDDEN",
              "RESOURCE_NOT_FOUND",
              "METHOD_NOT_ALLOWED",
              "UNSUPPORTED_MEDIA_TYPE",
              "CONFLICT",
              "EMAIL_ALREADY_REGISTERED",
              "DUPLICATE_ACCOUNT",
              "CONCURRENT_MODIFICATION",
              "BUSINESS_RULE_VIOLATED",
              "INSUFFICIENT_FUNDS",
              "ACCOUNT_CLOSED",
              "ACCOUNT_NOT_EMPTY",
              "SAME_ACCOUNT_TRANSFER",
              "CURRENCY_MISMATCH",
              "UNSUPPORTED_CURRENCY",
              "SYSTEM_ACCOUNT_OPERATION",
              "INVALID_AMOUNT",
              "IDEMPOTENCY_KEY_REUSED",
              "BALANCE_LIMIT_EXCEEDED",
              "RATE_LIMITED",
              "INTERNAL_ERROR"
            ],
            "type": "string"
          },
          "detail": {
            "description": "Human-readable message, may change; do not parse it",
            "example": "Insufficient funds on account 2",
            "type": "string"
          },
          "errors": {
            "description": "Present only for VALIDATION_FAILED",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "type": "array"
          },
          "instance": {
            "example": "/api/transfers",
            "type": "string"
          },
          "status": {
            "example": 422,
            "format": "int32",
            "type": "integer"
          },
          "timestamp": {
            "format": "date-time",
            "type": "string"
          },
          "title": {
            "example": "Business rule violated",
            "type": "string"
          },
          "type": {
            "example": "about:blank",
            "type": "string"
          }
        }
      },
      "CreateAccountRequest": {
        "properties": {
          "currency": {
            "minLength": 1,
            "pattern": "^[A-Z]{3}$",
            "type": "string"
          }
        },
        "required": [
          "currency"
        ],
        "type": "object"
      },
      "DepositRequest": {
        "properties": {
          "accountId": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "amount": {
            "minimum": 0,
            "type": "number"
          }
        },
        "required": [
          "accountId",
          "amount"
        ],
        "type": "object"
      },
      "Entry": {
        "properties": {
          "accountId": {
            "format": "int64",
            "type": "integer"
          },
          "amount": {
            "type": "number"
          },
          "direction": {
            "enum": [
              "DEBIT",
              "CREDIT"
            ],
            "type": "string"
          }
        },
        "type": "object"
      },
      "FieldError": {
        "description": "Present only for VALIDATION_FAILED",
        "properties": {
          "field": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "OperationResponse": {
        "properties": {
          "accountId": {
            "format": "int64",
            "type": "integer"
          },
          "amount": {
            "type": "number"
          },
          "counterpartyAccountId": {
            "format": "int64",
            "type": "integer"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "direction": {
            "enum": [
              "DEBIT",
              "CREDIT"
            ],
            "type": "string"
          },
          "entryId": {
            "format": "int64",
            "type": "integer"
          },
          "transactionId": {
            "format": "int64",
            "type": "integer"
          },
          "type": {
            "enum": [
              "TRANSFER",
              "DEPOSIT",
              "WITHDRAWAL"
            ],
            "type": "string"
          }
        },
        "type": "object"
      },
      "PageResponseOperationResponse": {
        "properties": {
          "content": {
            "items": {
              "$ref": "#/components/schemas/OperationResponse"
            },
            "type": "array"
          },
          "page": {
            "format": "int32",
            "type": "integer"
          },
          "size": {
            "format": "int32",
            "type": "integer"
          },
          "totalElements": {
            "format": "int64",
            "type": "integer"
          },
          "totalPages": {
            "format": "int32",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "TransactionResponse": {
        "properties": {
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "entries": {
            "items": {
              "$ref": "#/components/schemas/Entry"
            },
            "type": "array"
          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "status": {
            "enum": [
              "PENDING",
              "COMPLETED",
              "FAILED"
            ],
            "type": "string"
          },
          "type": {
            "enum": [
              "TRANSFER",
              "DEPOSIT",
              "WITHDRAWAL"
            ],
            "type": "string"
          }
        },
        "type": "object"
      },
      "TransferRequest": {
        "properties": {
          "amount": {
            "minimum": 0,
            "type": "number"
          },
          "fromAccountId": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "toAccountId": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "amount",
          "fromAccountId",
          "toAccountId"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Wallets and transfers on a double-entry ledger. Errors: application/problem+json with a stable `code` (see the ApiError schema).",
    "title": "ESEP Ledger Service",
    "version": "v1"
  },
