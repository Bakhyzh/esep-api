<spring-cloud.version>2025.1.4</spring-cloud.version></properties>
  <dependencyManagement><dependencies>
            <dependency><groupId>at.yawk.lz4</groupId><artifactId>lz4-java</artifactId><version>${esep.lz4.version}</version></dependency>
