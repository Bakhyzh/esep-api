            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const acc = pm.response.json().find(a => a.status === \"ACTIVE\" && a.currency === pm.collectionVariables.get(\"currency\"));",
                  "if (acc) { pm.collectionVariables.set(\"aliceAccountId\", acc.id); }",
                  "pm.test(\"Active account saved to aliceAccountId\", () => pm.expect(acc).to.exist);"
                ]
              }
            }
          ]
        },
