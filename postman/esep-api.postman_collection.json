{
  "info": {
    "name": "Esep API",
    "description": "Wallets and transfers with a double-entry ledger.\n\nRun folders in order: Auth -> Accounts -> Transactions -> Security -> Errors.\nDev seed users (password `password123`): alice@esep.dev, bob@esep.dev (USER), admin@esep.dev (ADMIN).\nAuth/Login requests save JWTs to aliceToken, bobToken, adminToken; other requests use them as Bearer tokens.\nIdempotency keys are generated in pre-request scripts; the 'retry' request reuses the previous key on purpose.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{aliceToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "password",
      "value": "password123"
    },
    {
      "key": "aliceEmail",
      "value": "alice@esep.dev"
    },
    {
      "key": "bobEmail",
      "value": "bob@esep.dev"
    },
    {
      "key": "adminEmail",
      "value": "admin@esep.dev"
    },
    {
      "key": "currency",
      "value": "KZT"
    },
    {
      "key": "aliceToken",
      "value": ""
    },
    {
      "key": "bobToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "bobUserId",
      "value": ""
    },
    {
      "key": "aliceAccountId",
      "value": ""
    },
    {
      "key": "bobAccountId",
      "value": ""
    },
    {
      "key": "transactionId",
      "value": ""
    },
    {
      "key": "depositKey",
      "value": ""
    },
    {
      "key": "transferKey",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register new user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user-{{$timestamp}}@esep.dev\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Role is USER, no password hash\", () => {",
                  "    pm.expect(pm.response.json().role).to.eql(\"USER\");",
                  "    pm.expect(pm.response.json()).to.not.have.property(\"passwordHash\");",
                  "});"
                ]
              }
            }
          ]
        },
