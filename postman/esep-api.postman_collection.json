    {
      "name": "Transactions",
      "item": [
        {
          "name": "Deposit 500 to Alice (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{depositKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/deposits",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "deposits"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountId\": {{aliceAccountId}},\n  \"amount\": 500\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"depositKey\", pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Balanced: system DEBIT + user CREDIT\", () =>",
                  "    pm.expect(pm.response.json().entries.map(x => x.direction)).to.eql([\"DEBIT\", \"CREDIT\"]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Transfer 100.25 Alice -> Bob",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{transferKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/transfers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "transfers"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromAccountId\": {{aliceAccountId}},\n  \"toAccountId\": {{bobAccountId}},\n  \"amount\": 100.25\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"transferKey\", pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"transactionId\", pm.response.json().id);",
                  "pm.test(\"Location header\", () => pm.response.to.have.header(\"Location\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Transfer retry (same key) -> 200 replay",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{transferKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/transfers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "transfers"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromAccountId\": {{aliceAccountId}},\n  \"toAccountId\": {{bobAccountId}},\n  \"amount\": \"100.2500\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Same Idempotency-Key and same request (100.2500 == 100.25): original result, money moves once."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Marked as replay\", () => pm.expect(pm.response.headers.get(\"Idempotent-Replayed\")).to.eql(\"true\"));",
                  "pm.test(\"Same transaction id\", () =>",
                  "    pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get(\"transactionId\"))));"
                ]
              }
            }
          ]
        },
        {
          "name": "Transfer same key, different amount -> 422",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{transferKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/transfers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "transfers"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromAccountId\": {{aliceAccountId}},\n  \"toAccountId\": {{bobAccountId}},\n  \"amount\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 422\", () => pm.response.to.have.status(422));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get transaction (Alice)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/transactions/{{transactionId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "transactions",
                "{{transactionId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Entries sum to zero\", () => {",
                  "    const sum = pm.response.json().entries.reduce((s, e) => s + (e.direction === \"DEBIT\" ? -e.amount : e.amount), 0);",
                  "    pm.expect(Math.abs(sum)).to.be.below(1e-9);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get transaction (Bob, receiver)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/transactions/{{transactionId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "transactions",
                "{{transactionId}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bobToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
