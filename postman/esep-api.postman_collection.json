      ]
    },
    {
      "name": "Accounts",
      "item": [
        {
          "name": "Create Alice account",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/accounts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "accounts"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currency\": \"{{currency}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set(\"aliceAccountId\", pm.response.json().id);",
                  "}",
                  "pm.test(\"201 Created, or 409 if it already exists (then run the List request)\", () =>",
                  "    pm.expect(pm.response.code).to.be.oneOf([201, 409]));"
                ]
              }
            }
          ]
        },
