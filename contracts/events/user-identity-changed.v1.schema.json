{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UserIdentityChangedV1",
  "type": "object",
  "required": [
    "schemaVersion",
    "eventType",
    "eventId",
    "userId",
    "issuer",
    "subject",
    "version",
    "status",
    "occurredAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "eventType": {
      "const": "USER_IDENTITY_CHANGED"
    },
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "userId": {
      "type": "integer",
      "minimum": 1
    },
    "issuer": {
      "type": "string",
      "format": "uri"
    },
    "subject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "ACTIVE",
        "DISABLED"
      ]
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
